# 이 파일을 .env 로 복사한 뒤 실 키를 채워 사용
# cp .env.example .env

# PortOne v2 — 콘솔(https://admin.portone.io) > 상점/채널 에서 발급
# storeId 형식: store-xxxxxxxx-xxxx-... (UUID)
PORTONE_STORE_ID=

# api-secret: 콘솔 > API Keys 에서 발급 (서버용, 노출 금지)
PORTONE_API_SECRET=

# 채널 키: 콘솔 > 결제 연동 > 채널 관리 에서 카카오페이 채널 생성 후 복사
# 형식: channel-key-xxxxxxxx-xxxx-...
PORTONE_CHANNEL_KEY_KAKAO_PAY=

# 웹훅 시크릿: 콘솔 > 결제 연동 > 웹훅 에서 발급 (서명 검증용, 노출 금지)
# 형식: whsec_xxxxxxxxxxxx (미설정 시 application.yml 의 테스트 더미값 사용 → 실 웹훅 401)
PORTONE_WEBHOOK_SECRET=

# MySQL — 로컬은 임의값으로 시작 가능, 운영은 16자 이상 랜덤 문자열로 변경
# 권장: openssl rand -base64 24
MYSQL_DATABASE=pos_saas
MYSQL_USER=pos
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme